# Server Configuration
NODE_ENV=production
PORT=4000
API_HOST=0.0.0.0

# Database - Use MongoDB Atlas URI for production
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/evo5

# JWT Secret - Generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# Optional: Real MongoDB (if not set, uses in-memory for demo)
# MONGO_URI=mongodb://localhost:27017/evo5

# Optional: Seed database on startup
# SEED=true