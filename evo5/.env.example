# Docker Compose Environment Variables
# Copy this to .env and fill in your values

# Required: Generate a strong random string (32+ chars)
# openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Required: Your production frontend URL (comma-separated for multiple)
FRONTEND_URL=https://your-domain.com

# Optional: MongoDB connection (if using external MongoDB instead of compose)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/evo5